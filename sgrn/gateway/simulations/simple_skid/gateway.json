{
  "listen": {
    "s7": {
      "ip": "0.0.0.0",
      "port": 102,
      "max_clients": 10,
      "pdu_size": 960
    },
    "http": {
      "ip": "0.0.0.0",
      "port": 8000
    },
    "websocket": {
      "ip": "0.0.0.0",
      "port": 8001
    },
    "opcua": {
      "ip": "0.0.0.0",
      "port": 4840
    }
  },
  "schema": "./sgrn/gateway/simulations/simple_skid/schema.scl",
  "state_dir": "/tmp/sgrn-gateway-state",
  "telemetry_buffer": {
    "snapshot_mode": "Anchored",
    "batch_size": 50,
    "batch_interval_s": 1,
    "zstd_level": 5
  },
  "reconnect_ms": 5000,
  "security_policy": "permissive",
  "security_script": "./sgrn/gateway/simulations/simple_skid/security.as",
  "persistence": {
    "enabled": true,
    "mode": "changes_with_timestamp",
    "namespaces": ["TankSkid"],
    "atomic_window_ms": 10,
    "batch_size": 5,
    "batch_interval_s": 2,
    "zstd_level": 5
  }
}
