DATA_BLOCK "Data" DB 1
VAR
    uint : Uint;
    udint: Udint;
    // ── Neutron flux & power ──
    thermal_power_mw    : LReal;    // current thermal output (0 – 3400 MW)
    thermal_power_pct   : Real;     // percentage of rated power
    neutron_flux        : LReal;    // neutron flux (n/cm²·s)
    avg_linear_heat_kw  : Real;     // average linear heat rate (kW/m)
    reactivity_pcm      : Real;     // excess reactivity (pcm)
    period_s            : Real;     // reactor period (s), negative = subcritical
    timestamp           : DTL;
END_VAR
END_DATA_BLOCK

