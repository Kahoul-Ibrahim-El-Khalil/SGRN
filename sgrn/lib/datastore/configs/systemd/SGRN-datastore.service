[Unit]
Description=SGRN Core Monolith (Micromamba)
After=network.target SGRN-postgres.service SGRN-garage.service SGRN-nginx.service
Requires=SGRN-postgres.service SGRN-garage.service SGRN-nginx.service

[Service]
User=${SGRN_USER}
Type=simple
WorkingDirectory=${SGRN_DATA_DIR}

EnvironmentFile=${SGRN_DATA_DIR}/.env
Environment="PATH=${SGRN_DEPLOYMENT_ENV}/bin:/usr/bin:/bin"
Environment="SGRN_CONFIG_PATH=${SGRN_DATA_DIR}/sgrn.json"
# Readiness gate: After= only orders startup, it never waits for Garage to
# accept traffic — without this the bucket check at boot races Garage's own
# startup. Address must match api_bind_addr / [admin] in garage.toml.
# Fails the start (loudly) if Garage is not ready within
# ~90s instead of booting degraded.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 180); do /usr/bin/curl -sf http://127.0.0.1:3903/health >/dev/null && exit 0; sleep 0.5; done; echo "SGRN-datastore: Garage not ready after 90s, refusing to start" >&2; exit 1'
ExecStart=${SGRN_BIN_DIR}/sgrn_datastore

Restart=on-failure
RestartSec=5
LimitNOFILE=65536

ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
