{
  "schema": "./sgrn/gateway/simulations/bottling/schema.scl",
  "state_dir": "/tmp/sgrn-gateway-state",
  "reconnect_ms": 5000,
  "security_policy": "strict",
  "security_script": "./sgrn/gateway/simulations/bottling/security.as",

  "southbound": {
    "s7": {
      "ip": "0.0.0.0",
      "port": 102,
      "max_clients": 12,
      "pdu_size": 960
    }
  },

  "northbound": {
    "http": {
      "ip": "0.0.0.0",
      "port": 8000
    },
    "websocket": {
      "ip": "0.0.0.0",
      "port": 8001
    },
    "opcua": {
      "ip": "0.0.0.0",
      "port": 4840
    }
  },

  "persistence": {
    "enabled": false,
    "mode": "changes_with_timestamp",
    "format": "binary",
    "namespaces": ["DB1", "DB2", "DB3", "DB4", "DB5", "DB6", "DB7", "DB8", "DB9", "DB10", "DB11", "DB12", "DB13", "DB14", "DB15", "DB16", "DB17", "DB18"],
    "atomic_window_ms": 10,
    "max_events": 100,
    "batch_interval_s": 30,
    "anchor_interval_s": 300,
    "anchor_change_count": 50,
    "zstd_level": 9
  }
}
