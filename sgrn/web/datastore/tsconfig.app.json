// tsconfig.app.json
{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "types": ["vite/client"],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "moduleDetection": "force",
        "composite": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "../..",
        "outDir": "dist/types-app",
        "jsx": "react-jsx",
        /* Path alias support */
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@sgrn/types": ["../../typescript/types/src/index.ts"],
            "@sgrn/datastore": ["../../typescript/datastore/src/index.ts"],
            "@sgrn/datastore/web": ["../../typescript/datastore/src/web.ts"],
            "@sgrn/datastore/requests": ["../../typescript/datastore/src/requests.ts"],
            "@sgrn/datastore/crud-requests": ["../../typescript/datastore/src/crud-requests.gen.ts"],
            "@sgrn/datastore/crud-responses": ["../../typescript/datastore/src/crud-responses.gen.ts"]
        },
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedSideEffectImports": true
    },
    "include": [
        "src",
        "../../typescript/datastore/src/web.ts",
        "../../typescript/datastore/src/wire.ts",
        "../../typescript/datastore/src/requests.ts",
        "../../typescript/datastore/src/crud-requests.gen.ts",
        "../../typescript/datastore/src/crud-responses.gen.ts",
        "../../typescript/types/src/**/*"
    ]
}
