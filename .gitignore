# ── Generated by CMake — leaks local paths/usernames, never commit ──────────
# Confirmed present in: root (symlink), sgrn/sdk/, sgrn/utils/,
# sgrn/datastore/, sgrn/datastore/configs/ — pattern below matches all of them.
compile_commands.json

cmake/*.cpp

# ── Node dependencies ─────────────────────────────────────────────────────────
# Confirmed present: root-level node_modules/, plus nested under
# sgrn/gateway/web-svelte and the datastore React dashboard.
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock

# ── Build, distribution and dependency prefix (hidden dirs, clean source view)
.dist/
.build/
.prefix/

# Legacy names (kept for safety during transition)
# Confirmed: sgrn/build/linux-static-release exists on disk — caught here.
dist/
build/
out/
prefix/

# ── Python ─────────────────────────────────────────────────────────────────
*.pyc
__pycache__/

# ── Local environment files ──────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Log files ─────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build_error.log

backend/data/

# ── IDE / editor files ─────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ── OS generated files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Hidden files and folders (selectively ignored) ───────────────────────
.*
!.gitignore
!.gitmodules
!.gitattributes
!.clang-format
!.clangd
!.clang-tidy
!.github/

# ── Optional: cache folders ──────────────────────────────────────────────
.cache/
compile_commands.json
