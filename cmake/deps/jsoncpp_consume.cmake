# cmake/jsoncpp.cmake — expose jsoncpp as sgrn::jsoncpp / JsonCpp::JsonCpp
# ─────────────────────────────────────────────────────────────────────────────
include_guard(GLOBAL)

# 1. Pre-built installed deps — extern-config.cmake already declared JsonCpp::JsonCpp
if(SGRN_USE_INSTALLED_DEPS AND TARGET JsonCpp::JsonCpp)
    target_link_libraries(sgrn::jsoncpp INTERFACE JsonCpp::JsonCpp)
    set(SGRN_JSONCPP_FROM_ENV ON)
    message(STATUS "[SGRN/jsoncpp] Using pre-compiled jsoncpp from ${SGRN_LOCAL_PREFIX}")
    return()
endif()

# 2. Source build (all cross-compile and linux-static paths share the same logic)
if(SGRN_CROSS_ARM64 OR SGRN_CROSS_WIN64 OR SGRN_BUILD_STATIC OR NOT BUILD_SHARED_LIBS)
    sgrn_fetch_source(jsoncpp)
    set(JSONCPP_WITH_TESTS OFF CACHE BOOL "" FORCE)
    set(JSONCPP_WITH_POST_BUILD_UNITTEST OFF CACHE BOOL "" FORCE)
    set(JSONCPP_WITH_PKGCONFIG_SUPPORT OFF CACHE BOOL "" FORCE)
    set(JSONCPP_WITH_EXAMPLE OFF CACHE BOOL "" FORCE)
    set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
    if(NOT TARGET jsoncpp_static AND NOT TARGET jsoncpp_lib)
        add_subdirectory("${jsoncpp_SOURCE_DIR}"
            "${CMAKE_BINARY_DIR}/extern/jsoncpp" EXCLUDE_FROM_ALL)
    endif()
    foreach(_jt IN ITEMS jsoncpp_static jsoncpp_lib)
        if(TARGET ${_jt})
            target_link_libraries(sgrn::jsoncpp INTERFACE ${_jt})
            if(SGRN_CROSS_ARM64 OR SGRN_CROSS_WIN64)
                set_target_properties(${_jt} PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED ON)
                target_compile_definitions(${_jt} INTERFACE JSONCPP_HAS_STRING_VIEW=1)
            endif()
            break()
        endif()
    endforeach()
    target_include_directories(sgrn::jsoncpp INTERFACE "${jsoncpp_SOURCE_DIR}/include")
    target_compile_definitions(sgrn::jsoncpp INTERFACE JSONCPP_DLL=0)
    if(SGRN_CROSS_ARM64)
        target_compile_definitions(sgrn::jsoncpp INTERFACE JSONCPP_HAS_STRING_VIEW=1)
        target_compile_options(sgrn::jsoncpp INTERFACE -DJSONCPP_HAS_STRING_VIEW=1)
    endif()
    if(NOT TARGET JsonCpp::JsonCpp)
        add_library(JsonCpp::JsonCpp INTERFACE IMPORTED GLOBAL)
        target_link_libraries(JsonCpp::JsonCpp INTERFACE sgrn::jsoncpp)
    endif()
    set(SGRN_JSONCPP_FROM_ENV ON)
    return()
endif()

# 3. Linux dynamic build — use conda/system package
if(NOT TARGET jsoncpp_lib AND NOT TARGET jsoncpp_static AND NOT TARGET extern::jsoncpp_lib)
    find_package(jsoncpp CONFIG QUIET)
    if(NOT jsoncpp_FOUND)
        find_package(jsoncpp QUIET)
    endif()
endif()
foreach(_jt IN ITEMS extern::jsoncpp_lib jsoncpp_static jsoncpp_lib JsonCpp::JsonCpp)
    if(TARGET ${_jt})
        target_link_libraries(sgrn::jsoncpp INTERFACE ${_jt})
        break()
    endif()
endforeach()
set(SGRN_JSONCPP_FROM_ENV ON)
